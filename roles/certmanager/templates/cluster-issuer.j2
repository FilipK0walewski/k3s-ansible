apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ acme.cluster_issuer_name }}
spec:
  acme:
    email: {{ acme.email }}
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: {{ acme.cluster_issuer_name }}-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: {{ cloudflare.secret_name }}
              key: {{ cloudflare.secret_key }}
