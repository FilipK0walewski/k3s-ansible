apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ certificate.name }}
  namespace: {{ certificate.namespace }}
spec:
  secretName: {{ certificate.secret_name }}
  issuerRef:
    name: {{ acme.cluster_issuer_name }}
    kind: ClusterIssuer
  privateKey:
    rotationPolicy: Always
  dnsNames:
{% for domain in certificate.wildcard_domains %}
    - "{{ domain }}"
{% endfor %}
